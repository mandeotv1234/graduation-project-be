                        "studentQuery": "INSERT INTO Xe VALUES (1, N'30A-12345', N'Toyota Vios', 500000.00), (2, N'51B-67890', N'Honda City', 450000.00), (3, N'43C-11111', N'Ford Ranger', 700000.00);"
