  "components": {
    "schemas": {
      "CreateExamQuestionRequestDto": {
        "type": "object",
        "required": [
          "content",
          "correctQuery",
          "points",
          "questionType"
        ],
        "properties": {
          "content": {
            "type": "string",
            "description": "Question content/description"
          },
          "correctQuery": {
            "type": "string",
            "description": "SQL query to verify the answer"
          },
          "difficultyLevel": {
            "type": "integer",
            "description": "Difficulty level (1-5)"
          },
          "points": {
            "type": "number",
            "format": "decimal",
            "description": "Points for this question"
          },
          "orderIndex": {
            "type": "integer",
            "description": "Display order of the question"
          },
          "questionType": {
            "$ref": "#/components/schemas/QuestionType"
          },
          "verifyScript": {
            "type": "string",
            "nullable": true,
            "description": "SQL script to verify TRIGGER/FUNCTION/SP behavior, or hardcoded expected result for CREATE_TABLE/INSERT_DATA/SELECT_QUERY"
          }
        }
      },
      "QuestionType": {
        "type": "string",
        "enum": [
          "CREATE_TABLE",
          "INSERT_DATA",
          "SELECT_QUERY",
          "TRIGGER",
          "FUNCTION",
          "STORED_PROCEDURE"
        ],
        "description": "Type of exam question determining the grading strategy"
      },
      "ExecuteSqlRequestDto": {
        "type": "object",
        "required": [
          "sql"
        ],
        "properties": {
          "sql": {
            "type": "string",
            "description": "SQL statement to execute on student's schema"
          }
        }
      },
      "SubmitExamRequestDto": {
        "type": "object",
        "required": [
          "answers"
        ],
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerItemDto"
            },
            "description": "List of all question answers"
          }
        }
      },
      "AnswerItemDto": {
        "type": "object",
        "required": [
          "questionId",
          "studentQuery"
        ],
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int64",
            "description": "ID of the question being answered"
          },
          "studentQuery": {
            "type": "string",
            "description": "Student's SQL answer"
          }
        }
      },
      "SubmitExamSuccessResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SubmitExamResponseDto"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "code": {
            "type": "string",
            "example": "CREATED"
          },
          "message": {
            "type": "string",
            "example": "Exam submitted and graded successfully"
          }
        }
      },
      "SubmitExamResponseDto": {
        "type": "object",
        "properties": {
          "examId": {
            "type": "integer",
            "format": "int64"
          },
          "studentId": {
            "type": "integer",
            "format": "int64"
          },
          "totalScore": {
            "type": "number",
            "format": "decimal",
            "description": "Total score earned"
          },
          "maxScore": {
            "type": "number",
            "format": "decimal",
            "description": "Maximum possible score"
          },
          "totalQuestions": {
            "type": "integer"
          },
          "correctCount": {
            "type": "integer"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "questionResults": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionResultDto"
            }
          }
        }
      },
      "QuestionResultDto": {
        "type": "object",
        "properties": {
          "submissionId": {
            "type": "integer",
            "format": "int64"
          },
          "questionId": {
            "type": "integer",
            "format": "int64"
          },
          "orderIndex": {
            "type": "integer"
          },
          "studentQuery": {
            "type": "string"
          },
          "isCorrect": {
            "type": "boolean"
          },
          "scoreEarned": {
            "type": "number",
            "format": "decimal"
          },
          "maxPoints": {
            "type": "number",
            "format": "decimal"
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          },
          "executionTimeMs": {
            "type": "integer"
          }
        }
      },
      "CreateSchemaTemplateRequestDto": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Template name"
          },
          "ddlScript": {
            "type": "string",
            "nullable": true,
            "description": "DDL script to create tables"
          },
          "defaultDataScript": {
            "type": "string",
            "nullable": true,
            "description": "DML script for default data"
          }
        }
      },
      "LoginRequestDto": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^[a-zA-Z0-9._%+-]+@student\\.hcmus\\.edu\\.vn$",
            "description": "User email address. Must be a valid HCMUS student email ending with @student.hcmus.edu.vn",
            "example": "22120201@student.hcmus.edu.vn"
          },
          "password": {
            "type": "string",
            "format": "password",
            "pattern": "^(?=.*[A-Z])(?=.*\\d)(?=.*[^A-Za-z\\d]).{8,}$",
            "description": "User password. Must be at least 8 characters and include 1 uppercase letter, 1 number, and 1 special character",
            "example": "Password123!",
            "minLength": 8
          }
        },
        "description": "Login request payload containing user credentials"
      },
      "LoginResponseDto": {
        "type": "object",
        "required": [
          "accessToken",
          "expiresAt"
        ],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token for authenticated requests",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIyMjEyMDIwMUBzdHVkZW50LmhjbXVzLmVkdS52biIsInJvbGUiOiJTVFVERU5UIiwiaWF0IjoxNjk5NDY0MDAwLCJleHAiOjE2OTk1NTA0MDB9.signature"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Access token expiration timestamp",
            "example": "2025-11-09T11:30:00.000"
          }
        },
        "description": "Login response containing JWT access token and expiration time"
      },
      "LoginSuccessResponse": {
        "type": "object",
        "required": [
          "data",
          "meta",
          "code",
          "message"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/LoginResponseDto"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "code": {
            "type": "string",
            "description": "Response code",
            "example": "OK"
          },
          "message": {
            "type": "string",
            "description": "Response message",
            "example": "Login successful"
          }
        },
        "description": "Wrapper object for successful login response"
      },
      "RefreshTokenResponseDto": {
        "type": "object",
        "required": [
          "accessToken",
          "expiresAt"
        ],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "New JWT access token",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIyMjEyMDIwMUBzdHVkZW50LmhjbXVzLmVkdS52biIsInJvbGUiOiJTVFVERU5UIiwiaWF0IjoxNjk5NDY0MDAwLCJleHAiOjE2OTk1NTA0MDB9.signature"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "New access token expiration timestamp",
            "example": "2025-11-09T11:30:00.000"
          }
        },
        "description": "Refresh token response containing new JWT access token"
      },
      "RefreshSuccessResponse": {
        "type": "object",
        "required": [
          "data",
          "meta",
          "code",
          "message"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RefreshTokenResponseDto"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "code": {
            "type": "string",
            "description": "Response code",
            "example": "OK"
          },
          "message": {
            "type": "string",
            "description": "Response message",
            "example": "Token refreshed"
          }
        },
        "description": "Wrapper object for successful refresh response"
      },
      "MessageResponse": {
        "type": "object",
        "required": [
          "meta",
          "code",
          "message"
        ],
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "code": {
            "type": "string",
            "description": "Response code",
            "example": "OK"
          },
          "message": {
            "type": "string",
            "description": "Response message",
            "example": "Logout successful"
          }
        },
        "description": "Simple message response without data"
      },
      "Meta": {
        "type": "object",
        "required": [
          "timestamp"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the response",
            "example": "2025-11-09T10:30:00.000Z"
          }
        },
        "description": "Metadata containing response timestamp"
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "message",
          "code"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable error message",
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "INTERNAL_SERVER_ERROR",
              "JWT_TOKEN_INVALID",
              "STATUS_NOT_FOUND",
              "ROLE_NOT_FOUND",
              "DUPLICATE_BOOKMARK",
              "INVALID_FORMAT",
              "INVALID_BUSINESS_RULE",
              "NOT_FOUND",
              "BAD_REQUEST",
              "UNAUTHORIZED",
              "CONFLICT",
              "OPERATION_FAILED",
              "INTERNAL_ERROR",
              "DATABASE_ERROR"
            ],
            "description": "Error code identifying the type of error",
            "example": "UNAUTHORIZED"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDetail"
            },
            "description": "Array of field-specific validation errors (only present for validation failures)"
          }
        },
        "description": "Error response object"
      },
      "FieldErrorDetail": {
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "Name of the field that failed validation",
            "example": "email"
          },
          "message": {
            "type": "string",
            "description": "Validation error message for the field",
            "example": "Email must end with @student.hcmus.edu.vn"
          }
        },
        "description": "Field-level validation error details"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token obtained from login endpoint. Include in Authorization header as: Bearer {token}"
      }
    }
  },
  "security": []
}