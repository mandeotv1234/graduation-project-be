    "/api/exams/{examId}/submit": {
      "post": {
        "tags": [
          "Exams"
        ],
        "summary": "Submit entire exam",
        "description": "Submit all answers for an exam in one request. The server resets the student's schema, executes each answer sequentially, grades each question by type (CREATE_TABLE, INSERT_DATA, SELECT_QUERY, TRIGGER, FUNCTION, STORED_PROCEDURE), saves all submissions to DB, and returns the total score with per-question breakdown. Requires STUDENT role and enrollment.",
        "operationId": "submitExam",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "examId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitExamRequestDto"
              },
              "examples": {
                "fullExam": {
                  "summary": "Submit 10 answers",
                  "value": {
                    "answers": [
                      {
