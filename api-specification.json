                "createTable": {
                  "summary": "CREATE_TABLE question",
                  "value": {
                    "content": "Tạo bảng Xe gồm: MaXe (INT, PK), BienSo (NVARCHAR(20)), HangXe (NVARCHAR(50)), GiaThueNgay (DECIMAL(10,2))",
                    "correctQuery": "SELECT COLUMN_NAME, DATA_TYPE FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'Xe' ORDER BY ORDINAL_POSITION",
