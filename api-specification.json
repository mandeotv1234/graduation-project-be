    "description": "API specification for Graduation Project Backend - Built with Spring Boot 3.5.7 and Java 21, implementing Hexagonal Architecture (Ports & Adapters Pattern)",
    "contact": {
      "name": "manhuynh",
      "email": "22120201@student.hcmus.edu.vn"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    },
    {
      "url": "https://api.graduationproject.com",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Authentication and authorization endpoints"
    },
    {
      "name": "Users",
      "description": "User management endpoints"
    },
    {
      "name": "Classes",
      "description": "Class management endpoints (requires TEACHER role)"
